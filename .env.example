# Copy this file to ".env" at the repo root and adjust values as needed.
# All deploy scripts read from the top-level .env.
#
# IMPORTANT: Do not commit real secrets. Keep tokens/passwords out of version control.

############################################
# AAP (ansible_deployment)
############################################
AAP_HOSTNAME=https://your-aap-instance.example.com/
AAP_TOKEN=your-aap-oauth-token
AAP_VALIDATE_CERTS=false
AAP_ORG=Default

############################################
# ServiceNow
############################################
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-snow-password

############################################
# Demo EC2 (from terraform output)
############################################
DEMO_HOST_IP=

# SSH key for demo EC2 instances
DEMO_SSH_KEY_PATH=./setup/terraform/demo-key.pem

############################################
# AO Webhook (EDA-to-AO bridge)
############################################
# These are filled after publishing the AO workflow with an EDA trigger.
# See: https://docs.redhat.com/en/documentation/automation_orchestrator/2026.8/develop-add_an_event_driven_ansible_trigger
AO_WEBHOOK_BASE_URL=https://your-aap-instance.example.com
AO_WEBHOOK_PATH=your-workflow-trigger
AO_WEBHOOK_CLIENT_ID=your-ao-client-id
AO_WEBHOOK_CLIENT_SECRET=your-ao-client-secret

############################################
# MCP Servers (configured on AO agentic nodes, not used by playbooks)
############################################
# AAP MCP server — gives agentic nodes access to AAP tools (list templates, inventories, etc.)
AAP_MCP_URL=https://your-aap-mcp-server.example.com
# Add additional MCP servers as needed for your use case:
# LIGHTSPEED_MCP_URL=https://your-lightspeed-mcp-server.example.com
# CUSTOM_MCP_URL=https://your-custom-mcp-server.example.com

############################################
# EDA Decision Environment
############################################
# Custom DE image with servicenow.itsm for EDA polling.
# Build from dependencies/de/decision-environment.yml or use your own.
# See: ./dependencies/build-images.sh
DE_IMAGE=YOUR_REGISTRY/snow-de:latest

############################################
# AO API Service Account (for approval bridge)
############################################
# Create a service account in AO with project-admin role.
# Used by bridge_ao_approval.yml to programmatically approve AO workflow steps.
AO_SA_CLIENT_ID=your-ao-sa-client-id
AO_SA_CLIENT_SECRET=your-ao-sa-client-secret
