{
  "schema_version": "2.0.0",
  "name": "Example AO Workflow",
  "description": "Minimal AO workflow skeleton showing all four node types: aap_job_template, agentic, switch, and approval. Customize triggers, nodes, and edges for your use case.",
  "triggers": [
    {
      "id": "trigger_eda",
      "type": "eda_trigger",
      "name": "Event Trigger (EDA)",
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {
            "incident_number": {
              "type": "string",
              "description": "ServiceNow incident number"
            },
            "incident_sys_id": {
              "type": "string",
              "description": "ServiceNow incident sys_id"
            },
            "incident_description": {
              "type": "string",
              "description": "Incident short description + description"
            }
          }
        }
      },
      "position": { "x": 0, "y": 300 }
    }
  ],
  "nodes": [
    {
      "id": "create_incident",
      "type": "aap_job_template",
      "name": "Create SNOW Incident",
      "parameters": {
        "job_template_name": "Manage SNOW Incident",
        "organization_name": "Default",
        "extra_vars": {
          "action": "create",
          "short_description": "${trigger.incident_description}",
          "description": "Automated incident created by AO workflow."
        }
      },
      "position": { "x": 400, "y": 300 }
    },
    {
      "id": "ai_analysis",
      "type": "agentic",
      "name": "AI: Analyze Issue",
      "parameters": {
        "model": "llama-scout-17b",
        "prompt": "Analyze the following incident and provide a root cause assessment and recommended remediation steps.\n\nIncident: ${trigger.incident_description}\n\nProvide a concise analysis suitable for a ServiceNow work note (under 1000 characters)."
      },
      "position": { "x": 800, "y": 100 }
    },
    {
      "id": "severity_check",
      "type": "switch",
      "name": "Severity Check",
      "parameters": {
        "cases": [
          {
            "port": "case_high",
            "label": "High Severity",
            "condition": "${trigger.incident_urgency} == '1'"
          },
          {
            "port": "case_low",
            "label": "Low Severity",
            "condition": "${trigger.incident_urgency} != '1'"
          }
        ]
      },
      "position": { "x": 800, "y": 500 }
    },
    {
      "id": "approval_gate",
      "type": "approval",
      "name": "Awaiting Approval",
      "parameters": {
        "description": "Waiting for approval before proceeding with remediation. EDA will auto-approve when the CR is moved to Implement in ServiceNow.",
        "timeout": 0
      },
      "position": { "x": 1200, "y": 500 }
    },
    {
      "id": "update_incident",
      "type": "aap_job_template",
      "name": "Update Incident",
      "parameters": {
        "job_template_name": "Manage SNOW Incident",
        "organization_name": "Default",
        "extra_vars": {
          "action": "update",
          "inc_sys_id": "${create_incident.artifacts.inc_sys_id}",
          "work_notes": "AI Analysis:\n${ai_analysis.result.content}"
        }
      },
      "position": { "x": 1200, "y": 100 }
    },
    {
      "id": "resolve_incident",
      "type": "aap_job_template",
      "name": "Resolve Incident",
      "parameters": {
        "job_template_name": "Manage SNOW Incident",
        "organization_name": "Default",
        "extra_vars": {
          "action": "resolve",
          "inc_sys_id": "${create_incident.artifacts.inc_sys_id}",
          "work_notes": "Workflow complete. Incident resolved by automated remediation."
        }
      },
      "position": { "x": 1600, "y": 300 }
    }
  ],
  "edges": [
    { "from": "trigger_eda", "to": "create_incident" },
    { "from": "create_incident", "to": "ai_analysis" },
    { "from": "create_incident", "to": "severity_check" },
    { "from": "ai_analysis", "to": "update_incident" },
    { "from": "severity_check", "to": "approval_gate", "from_port": "case_high" },
    { "from": "approval_gate", "to": "resolve_incident", "from_port": "approved" },
    { "from": "severity_check", "to": "resolve_incident", "from_port": "case_low" },
    { "from": "update_incident", "to": "resolve_incident" }
  ]
}
