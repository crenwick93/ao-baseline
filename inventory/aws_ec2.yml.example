---
# AWS EC2 Dynamic Inventory — Example
#
# Copy to aws_ec2.yml and customize for your use case.
# This discovers EC2 instances by tag and sets ansible_host to the public IP.
#
# In AAP CaC, create an inventory source referencing this file:
#   controller_inventory_sources:
#     - name: "AWS EC2 Discovery"
#       inventory: "Your Inventory"
#       source: scm
#       source_project: "Your Project"
#       source_path: "inventory/aws_ec2.yml"
#       credential: "AWS"
#       overwrite: true
#       update_on_launch: true
#
# Requires an "Amazon Web Services" credential in AAP with
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.

plugin: amazon.aws.aws_ec2

regions:
  - eu-west-1

filters:
  tag:Name: ao-demo
  instance-state-name: running

keyed_groups:
  - key: tags.Name
    prefix: tag
    separator: "_"

compose:
  ansible_host: public_ip_address
  ansible_user: "'ec2-user'"
  ansible_ssh_common_args: "'-o StrictHostKeyChecking=no'"
